<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": the Inno Setup installers, built from the
     already signed programs (SignPath can't open Inno Setup installers to sign inside them).
     The bundled Virtual Display Driver keeps its own signature. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="freemonplay-windows-x64-setup.exe"/>
      <for-each>
        <authenticode-sign/>
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
